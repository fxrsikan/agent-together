{
  "name": "@agent-together/desktop",
  "version": "0.0.1",
  "description": "Agent Together: plan on a canvas, let AI coding assistants build it, with an observer keeping them in bounds",
  "license": "Apache-2.0",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && node scripts/bundle-hook.mjs",
    "start": "electron-vite preview",
    "dist": "npm run build && electron-builder --win -c.electronDist=../../node_modules/electron/dist",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "devDependencies": {
    "@agent-together/adapter-claude-code": "0.0.1",
    "@agent-together/adapter-codex": "0.0.1",
    "@agent-together/adapter-cursor": "0.0.1",
    "@agent-together/adapter-grok": "0.0.1",
    "@agent-together/core": "0.0.1",
    "@agent-together/schema": "0.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@xyflow/react": "^12.12.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.5"
  },
  "productName": "Agent Together",
  "author": "fxrsikan",
  "build": {
    "electronVersion": "45.2.1",
    "appId": "dev.agent-together.desktop",
    "productName": "Agent Together",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "out/hook/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "AgentTogether-Setup-${version}.exe",
      "shortcutName": "Agent Together"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "artifactName": "AgentTogether-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Development",
      "maintainer": "fxrsikan",
      "artifactName": "AgentTogether-${version}-${arch}.${ext}",
      "executableName": "agent-together"
    }
  }
}
