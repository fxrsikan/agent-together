{
  "name": "agent-together",
  "private": true,
  "description": "Canvas control plane for AI coding agents (working name: Agent Together)",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @agent-together/schema -w @agent-together/core -w @agent-together/adapter-claude-code -w @agent-together/adapter-codex -w @agent-together/adapter-cursor -w @agent-together/adapter-grok -w @agent-together/hook",
    "build:desktop": "npm run build -w @agent-together/desktop",
    "dev": "npm run dev -w @agent-together/desktop",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
